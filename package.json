{
	"name": "@drwally/n8n-nodes-integration",
	"version": "1.1.1",
	"description": "Integration node for Drwally",
	"license": "MIT",
	"homepage": "https://github.com/sinova-dev/drwally-n8n-node.git",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "DrWally",
		"email": "developers@2010in.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sinova-dev/drwally-n8n-node.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"npm": "11.6.2"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"format": "prettier . --write --log-level=warn",
		"format:check": "prettier . --check --log-level=warn",
		"pre-commit": "npm install && git add package-lock.json && npx lint-staged --allow-empty && tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DrWallyPrivateMessageApi.credentials.js",
			"dist/credentials/DrWallyGroupMessageApi.credentials.js",
			"dist/credentials/DrWallyTemplateMessageApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Drwally/Drwally.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@sinova-development/repos-configs": "^0.0.2",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"release-it": "^20.2.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"lint-staged": {
		"**/*": "prettier --write --ignore-unknown"
	}
}
